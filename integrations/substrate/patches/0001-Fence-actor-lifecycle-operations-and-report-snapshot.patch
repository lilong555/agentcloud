+		{name: "UID absent", mutate: func(r *ateapi.WaitActorSnapshotDurableRequest) { r.ExpectedUid = "" }},
+		{name: "UID malformed", mutate: func(r *ateapi.WaitActorSnapshotDurableRequest) { r.ExpectedUid = "actor" }},
+		{name: "snapshot absent", mutate: func(r *ateapi.WaitActorSnapshotDurableRequest) { r.SnapshotUuid = "" }},
+		{name: "snapshot malformed", mutate: func(r *ateapi.WaitActorSnapshotDurableRequest) { r.SnapshotUuid = "snapshot" }},
+		{name: "generation absent", mutate: func(r *ateapi.WaitActorSnapshotDurableRequest) { r.SnapshotGeneration = 0 }},
+		{name: "generation negative", mutate: func(r *ateapi.WaitActorSnapshotDurableRequest) { r.SnapshotGeneration = -1 }},
