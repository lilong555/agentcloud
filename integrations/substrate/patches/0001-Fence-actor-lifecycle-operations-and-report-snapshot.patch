+				tt.mutate(req)
+			}
+			errs := ValidateWaitActorSnapshotDurableRequest(context.Background(), req)
+			if (len(errs) == 0) != tt.valid {
+				t.Fatalf("validation=%v valid=%t", errs, tt.valid)
+			}
+		})
+	}
+}
