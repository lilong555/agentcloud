From b963832dab4447541f4034f5cd390e537a2df40f Mon Sep 17 00:00:00 2001
From: lilong555 <173714821+lilong555@users.noreply.github.com>
Date: Tue, 10 Nov 2026 00:00:00 +0000
Subject: [PATCH 3/3] Align native ZeroMQ command queues for SIMD builds


diff --git a/.cargo/config.toml b/.cargo/config.toml
index 1b99388182e28400109e5685243173d5ffb35bfa..015af3471a0795caaabe8153c5d44f4a8eaa73a6 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -17,6 +17,12 @@ rustflags = ["-C", "target-cpu=neoverse-n1", "-C", "force-frame-pointers=yes", "
 # Without this, pcre2-sys tries to find a system libpcre2 via pkg-config,
 # which breaks Docker builds and bundles a .so into the Python wheel.
 [env]
+# zeromq-src 0.2.6 does not probe posix_memalign. command_t requires 64-byte
+# alignment; malloc only guarantees 16 bytes on these Linux targets. With
+# AVX2, copying a command into such a queue faults on an aligned SIMD store.
+# Apply the same allocation ABI to every C++ translation unit.
+CXXFLAGS_x86_64_unknown_linux_gnu = "-DHAVE_POSIX_MEMALIGN=1 -DZMQ_CACHELINE_SIZE=64"
+CXXFLAGS_aarch64_unknown_linux_gnu = "-DHAVE_POSIX_MEMALIGN=1 -DZMQ_CACHELINE_SIZE=64"
 PCRE2_SYS_STATIC = "1"
 # Utoipa's default UI predates OpenAPI 3.2. This release loads the document;
 # rendering itemSchema remains limited (swagger-api/swagger-ui#11065).
